{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core permissions for the main planner window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://robertsspaceindustries.com/*" },
        { "url": "https://github.com/Sapd/ccu-planner/releases/latest" }
      ]
    }
  ]
}
