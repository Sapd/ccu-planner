{
  "name": "ccu-planner",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "capture": "node tools/capture.mjs",
    "login": "node -e \"import('./src/session.mjs').then(m => m.interactiveLogin())\"",
    "session": "node -e \"import('./src/session.mjs').then(m => m.refreshSession()).then(s => console.log('session ok, cookies:', s.cookies.length))\"",
    "sync": "node scripts/sync.mjs",
    "sync-images": "node scripts/sync-images.mjs",
    "sync-catalog": "node scripts/sync-catalog.mjs",
    "mcp": "node scripts/mcp.mjs",
    "release": "node scripts/release.mjs",
    "version": "node scripts/version.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "playwright": "^1.65.1"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "cheerio": "^1.1.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "bin": {
    "ccu-planner-mcp": "scripts/mcp.mjs"
  }
}
